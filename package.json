{
  "name": "inventory-order-management",
  "version": "1.0.0",
  "description": "Inventory & Order Management API",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/src/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest",
    "check": "npm run lint && npm run build && npm run test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "prisma": "^7.10.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
